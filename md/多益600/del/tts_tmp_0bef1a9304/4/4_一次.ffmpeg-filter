drawtext=font='Microsoft JhengHei':text='To make a reservation\, click\n\[here\] or call us at\n1-800-555-2222.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,712.056\,720.072)',
