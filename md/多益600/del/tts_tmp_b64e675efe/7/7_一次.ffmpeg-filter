drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='Paint is being poured onto the\nfloor.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,0.000\,2.736)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='油漆正在倒在地板上。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,0.000\,2.736)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='The brushes are resting on the\nladder.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,3.136\,5.944)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='刷子放在梯子上。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,3.136\,5.944)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='The worker is removing his gloves.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,6.344\,9.176)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='工人正在脫掉手套。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,6.344\,9.176)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='The workers are preparing to\npaint.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,9.576\,12.360)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='工人們正在準備油漆。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,9.576\,12.360)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='Will John replace the damaged\ngarage door or remove it?':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,12.760\,16.528)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='約翰會更換或拆除損壞的車庫門嗎？':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,12.760\,16.528)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='The renovations started two days\nago.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,16.928\,19.880)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='整修工作是在兩天前開始的。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,16.928\,19.880)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='I think he will have it repaired.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,20.280\,22.728)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='我想他會把它修好。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,20.280\,22.728)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='I will remove that for you later.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,23.128\,25.720)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='稍後我會為你刪除它。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,23.128\,25.720)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='You put the down payment on the\nhouse this week, right?':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,26.120\,29.840)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='你這週就付了房子的首付，對吧？':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,26.120\,29.840)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='Yes, the real estate agent is\nbusy.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,30.240\,33.528)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='是的，房地產經紀人很忙。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,30.240\,33.528)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='No, the property value hasn\'t gone\ndown.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,33.928\,37.432)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='不，房產價值並沒有下降。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,33.928\,37.432)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='Of course. I did it first thing on\nMonday.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,37.832\,42.008)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='當然。我周一做的第一件事就是這麼做。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,37.832\,42.008)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='Questions 53 to 55 refer to the\nfollowing conversation.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,42.408\,47.112)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='問題53至55涉及以下對話。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,42.408\,47.112)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='Good morning, Rick. I was hoping\nyou could help me out with a\nproblem I\'m having.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,47.512\,53.248)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='早安，瑞克。我希望你能幫助我解決我遇到的問題\n。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,47.512\,53.248)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='Of course. What do you need help\nwith?':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,53.648\,57.488)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='當然。您需要什麼幫助？':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,53.648\,57.488)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='Well, I\'m not sure if you\'ve\nheard, but I just got promoted to\nregional manager for our processor\nmanufacturing plant in Asia.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,57.888\,65.256)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='嗯，我不確定您是否聽說過，但我剛剛晉升為我們\n亞洲處理器製造工廠的區域經理。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,57.888\,65.256)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='Congratulations! That\'s fantastic\nnews.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,65.656\,70.240)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='恭喜！這是個好消息。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,65.656\,70.240)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='Thank you. But it means I\'m going\nto have to move there and, well,\nI\'m having trouble finding a\nplace.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,70.640\,77.816)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='謝謝。但這意味著我將不得不搬到那裡，而且我很\n難找到地方。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,70.640\,77.816)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='Then you\'ve come to the right\nspot. I can definitely help you\nfind a new apartment. What kind\nare you looking for?':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,78.216\,86.256)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='那麼您就來對地方了。我絕對可以幫助您找到新公\n寓。您在尋找什麼類型的？':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,78.216\,86.256)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='I don\'t need anything too\nspacious, so a studio apartment is\nfine. But I do need a kitchen and\nit needs to be furnished.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,86.656\,94.792)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='我不需要太寬敞的東西，所以單間公寓就可以了。\n但我確實需要一個廚房，而且需要配備家具。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,86.656\,94.792)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='Not a problem. Anything else?':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,95.192\,98.840)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='不是問題。還要別的嗎？':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,95.192\,98.840)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='If it could be a short drive from\nwork and have at least one\nsupermarket nearby, that would be\ngreat.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,99.240\,105.336)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='如果距離工作地點只有很短的車程，並且附近至少\n有一家超市，那就太好了。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,99.240\,105.336)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='And what kind of a budget are you\nlooking at?':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,105.736\,108.736)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='您正在考慮什麼樣的預算？':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,105.736\,108.736)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='The company will cover half of the\nrent, so anything under $1200 is\nfine.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,109.136\,115.256)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='公司會承擔一半的租金，所以 1200\n美元以下的都可以。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,109.136\,115.256)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='Great. I\'ll have a look and see\nwhat I can find.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,115.656\,120.048)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='偉大的。我會看一下，看看我能找到什麼。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,115.656\,120.048)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='What happened to the woman?':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,120.448\,122.632)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='那個女人怎麼了？':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,120.448\,122.632)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='She was let go from her job.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,123.032\,125.480)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='她被解雇了。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,123.032\,125.480)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='She received a pay raise.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,125.880\,128.256)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='她得到了加薪。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,125.880\,128.256)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='She opened a factory.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,128.656\,130.888)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='她開了一家工廠。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,128.656\,130.888)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='She was promoted.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,131.288\,133.256)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='她升職了。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,131.288\,133.256)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='What does the woman mention about\nher ideal apartment?':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,133.656\,137.184)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='這位女士提到她理想的公寓是什麼？':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,133.656\,137.184)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='It needs to include furniture.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,137.584\,140.128)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='它需要包括家具。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,137.584\,140.128)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='It needs a large space.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,140.528\,142.952)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='它需要一個大的空間。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,140.528\,142.952)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='It\'s better to be close to a park.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,143.352\,146.064)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='最好離公園近一點。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,143.352\,146.064)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='It\'s within walking distance.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,146.464\,149.008)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='步行即可到達。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,146.464\,149.008)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='What does the woman imply about\nthe rent?':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,149.408\,152.288)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='女人問房租這件事代表什麼？':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,149.408\,152.288)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='She will only have to pay part of\nit.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,152.688\,155.472)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='她只需要支付一部分。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,152.688\,155.472)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='She will be paying it entirely\nherself.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,155.872\,158.992)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='她將完全自己支付費用。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,155.872\,158.992)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='The company will cover the rent\ncompletely.':fontcolor=white:fontsize=44:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=108:enable='between(t\,159.392\,162.392)',
drawtext=fontfile='C\:/Windows/Fonts/msjh.ttc':text='公司將全額支付租金。':fontcolor=white:fontsize=34:line_spacing=12:bordercolor=black:borderw=3:fix_bounds=true:x=(w-text_w)/2:y=472:enable='between(t\,159.392\,162.392)',
